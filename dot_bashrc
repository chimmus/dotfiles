
export MANPATH=$HOME/.local/share/man:$MANPATH
export PATH=$HOME/.local/bin:$PATH

if command -v mise >/dev/null 2>&1; then eval "$(mise activate bash)"; fi
export EDITOR="nvim"
export VISUAL="nvim"

eval "$(starship init bash)"
eval "$(fzf --bash)"

alias la="ls -a"
alias repo="cd ~/repos"
alias otto="cd ~/sandbox/o ; ollama launch claude --model gemma4:31b-cloud"
alias ll="ls -l"
alias lla="ls -la"
alias lal="ls -la"
alias fcat='fzf --preview "cat {}"'
alias v="nvim"
alias s="spf"
alias podmane="podman exec -it -u vscode"

alias python="python3"
alias pip="pip3"

alias mr="mooce -t r -l"

export DOCKER_PATH=podman

alias devconup='GH_TOKEN=$(gh auth token) devcontainer up --docker-path podman --workspace-folder'

if command -v mise >/dev/null 2>&1; then eval "$(mise activate bash)"; fi
unset GH_TOKEN
