
export MANPATH=$HOME/.local/share/man:$MANPATH
export PATH=$HOME/.local/bin:$PATH
if command -v mise >/dev/null 2>&1; then eval "$(mise activate zsh)"; fi

# Setting NeoVim as the default editor
export EDITOR="nvim"
export VISUAL="nvim"

# Starship
eval "$(starship init zsh)"
eval "$(fzf --zsh)"

alias la="ls -a"
alias repo="cd ~/repos"
alias otto="cd ~/sandbox/o ; ollama launch claude --model gemma4:31b-cloud"
alias ll="ls -l"
alias lla="ls -a -l"
alias lal="ls -a -l"
alias fcat="fzf --preview "cat {}""
alias v="nvim"
alias s="spf"
alias podmane="podman exec -it -u vscode"

# Python alias
alias python="python3"
alias pip="pip3"

# Aliases for programs I made myself
alias mr="mooce -t r -l"

export DOCKER_PATH=podman
alias devconup='devcontainer up --docker-path podman --workspace-folder && unset GH_TOKEN'

if command -v mise >/dev/null 2>&1; then eval "$(mise activate zsh)"; fi

