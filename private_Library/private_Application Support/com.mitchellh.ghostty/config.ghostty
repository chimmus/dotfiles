
keybind = cmd+,=unbind
keybind = cmd+comma=text:\x15ghostty +edit-config\r

#background-blur = true
#background-opacity = 0.95

#window-colorspace = display-p3
#background = #222733
#palette = 0=#3A424A
#palette = 1=#9E5F50
#palette = 2=#7AA97C
#palette = 3=#C0AD6C
#palette = 4=#7695B1
#palette = 5=#B47EC8
#palette = 6=#8EC9CC
#palette = 7=#DFE5EB
#palette = 8=#4B5C6B
#palette = 9=#D17360
#palette = 10=#88BC83
#palette = 11=#E0C97E
#palette = 12=#7ABCE8
#palette = 13=#C88CE0
#palette = 14=#99DBDF
#palette = 15=#E7EEF5

theme = TokyoNight

macos-option-as-alt = true
selection-background = #3f5572
selection-foreground = cell-foreground

cursor-style = block
shell-integration-features = no-cursor
cursor-style-blink = false

macos-titlebar-style = transparent
window-theme = ghostty

working-directory = home
window-inherit-working-directory = false

keybind = cmd+t=unbind
keybind = cmd+t=new_window
keybind = ctrl+tab=ignore
keybind = ctrl+shift+tab=ignore

macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = #81e2ff
macos-icon-screen-color = #000000

window-width = 120
window-height = 30

macos-window-shadow = true

font-family = "SF Mono"

font-size = 12
font-thicken = true
font-thicken-strength = 160

window-padding-x = 8
window-padding-y = 6

window-position-x = 290
window-position-y = 190

